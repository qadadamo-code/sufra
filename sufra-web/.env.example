# ── Sufra web — environment variables ─────────────────────────────────────────────
# Copy to .env.local for `npm run dev`; on Vercel set them in Project → Settings → Environment Variables.
# The site builds and runs with NONE of these set (OpenStreetMap map, local recommender, no Google ratings).

# Server-only. Enables the Claude concierge at /api/ask. Never prefix with VITE_ (that would ship it to browsers).
ANTHROPIC_API_KEY=

# Optional, PUBLIC (bundled into the browser). Google Maps JavaScript API + Places API (New) browser key.
# Restrict it in Google Cloud: HTTP referrers = your domains; APIs = Maps JavaScript API, Places API (New).
# When set: Google map instead of OpenStreetMap, and live Google rating + review count on restaurant pages.
VITE_GOOGLE_MAPS_KEY=

# Optional: a Google Cloud map ID for styled/advanced markers in production (falls back to DEMO_MAP_ID).
VITE_GOOGLE_MAP_ID=
